{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/es", "destination": "/index.html" },
    { "source": "/en", "destination": "/index-en.html" },
    { "source": "/intake", "destination": "/intake-vercel.html" },
    { "source": "/privacidad", "destination": "/privacidad-vercel.html" },
    { "source": "/privacy", "destination": "/privacidad-en-vercel.html" }
  ],
  "headers": [
    {
      "source": "/intake",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
