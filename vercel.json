    { "source": "/portland", "has": [{ "type": "host", "value": "www.ivanwaisman.com" }], "destination": "https://psi.ivanwaisman.com/portland", "permanent": false },
    { "source": "/en/portland", "has": [{ "type": "host", "value": "www.ivanwaisman.com" }], "destination": "https://psi.ivanwaisman.com/en/portland", "permanent": false },
    { "source": "/en/therapy-for-expats", "has": [{ "type": "host", "value": "www.ivanwaisman.com" }], "destination": "https://psi.ivanwaisman.com/en/therapy-for-expats", "permanent": false }
  ],
  "rewrites": [
    { "source": "/es", "destination": "/index.html" },
    { "source": "/en", "destination": "/index-en.html" },
    { "source": "/en/self-esteem-therapy", "destination": "/self-esteem-therapy-en.html" },
    { "source": "/en/therapy-for-expats", "destination": "/therapy-for-expats-en.html" },
    { "source": "/en/online-therapy", "destination": "/online-therapy-en.html" },
